# Application Settings
NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-a-strong-random-secret-key

# Option 1: Single MySQL Connection URL (Render / Railway / PlanetScale / Aiven / TiDB)
# DATABASE_URL=mysql://username:password@your-mysql-host:3306/your_database_name

# Option 2: Individual MySQL Connection Variables
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=valhala_user
MYSQL_PASSWORD=valhala_pass
MYSQL_DATABASE=valhala_games
MYSQL_SSL=false
